:root {
  --echo-cyan: rgb(87, 239, 239);
  --echo-edge: rgba(67, 213, 218, 0.72);
  --echo-muted: rgb(142, 183, 189);
  --echo-danger: rgb(255, 112, 71);
}
.menu-root {
  width: 900px; height: 560px; flex-grow: 0;
  background-color: rgba(4, 17, 23, 0.97);
  border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px;
  border-left-color: var(--echo-edge); border-right-color: var(--echo-edge);
  border-top-color: var(--echo-edge); border-bottom-color: var(--echo-edge);
  border-top-left-radius: 18px; border-top-right-radius: 18px;
  border-bottom-left-radius: 18px; border-bottom-right-radius: 18px;
  overflow: hidden; color: white;
}
.ambient-glow { position: absolute; left: 32px; right: 32px; top: 28px; height: 3px; background-color: rgba(76, 241, 239, 0.38); }
.frame {
  position: absolute; left: 14px; right: 14px; top: 14px; bottom: 14px;
  border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px;
  border-left-color: rgba(95, 227, 231, 0.20); border-right-color: rgba(95, 227, 231, 0.20);
  border-top-color: rgba(95, 227, 231, 0.20); border-bottom-color: rgba(95, 227, 231, 0.20);
}
.screen { position: absolute; left: 58px; right: 58px; top: 52px; bottom: 44px; align-items: center; justify-content: flex-start; }
.hidden { display: none; }
.title { margin-top: 14px; color: var(--echo-cyan); font-size: 52px; -unity-font-style: bold; letter-spacing: 9px; -unity-text-align: middle-center; }
.subtitle { margin-top: 3px; color: rgb(198, 239, 241); font-size: 22px; letter-spacing: 4px; -unity-font-style: bold; -unity-text-align: middle-center; }
.warning-text { color: rgb(255, 178, 145); }
.danger-text { color: var(--echo-danger); }
.signal-line { width: 620px; height: 2px; margin-top: 17px; margin-bottom: 20px; background-color: rgba(87, 239, 239, 0.58); }
.danger-line { background-color: rgba(255, 112, 71, 0.72); }
.body { width: 680px; min-height: 62px; color: rgb(191, 215, 219); font-size: 22px; white-space: normal; -unity-text-align: middle-center; }
.compact { min-height: 38px; }
.button-row { width: 720px; margin-top: 24px; flex-direction: row; justify-content: center; }
.menu-button {
  width: 320px; height: 78px; margin-left: 9px; margin-right: 9px;
  background-color: rgba(8, 62, 68, 0.98); color: rgb(232, 255, 255);
  border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px;
  border-left-color: rgba(87, 239, 239, 0.72); border-right-color: rgba(87, 239, 239, 0.72);
  border-top-color: rgba(87, 239, 239, 0.72); border-bottom-color: rgba(87, 239, 239, 0.72);
  border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;
  font-size: 25px; -unity-font-style: bold; letter-spacing: 2px;
}
.menu-button:hover, .menu-button:focus {
  background-color: rgba(16, 111, 116, 1);
  border-left-color: white; border-right-color: white; border-top-color: white; border-bottom-color: white;
}
.menu-button:active { background-color: rgba(56, 189, 191, 1); }
.compact-label { font-size: 19px; letter-spacing: 1px; }
.menu-button:disabled {
  background-color: rgba(21, 29, 32, 0.94); color: rgb(83, 104, 108);
  border-left-color: rgba(71, 88, 91, 0.72); border-right-color: rgba(71, 88, 91, 0.72);
  border-top-color: rgba(71, 88, 91, 0.72); border-bottom-color: rgba(71, 88, 91, 0.72);
}
.primary { background-color: rgba(8, 79, 84, 0.98); }
.secondary { background-color: rgba(23, 35, 39, 0.98); }
.danger {
  background-color: rgba(116, 43, 23, 0.98);
  border-left-color: rgba(255, 126, 82, 0.88); border-right-color: rgba(255, 126, 82, 0.88);
  border-top-color: rgba(255, 126, 82, 0.88); border-bottom-color: rgba(255, 126, 82, 0.88);
}
.danger:hover, .danger:focus { background-color: rgba(173, 62, 30, 1); }
.single-button { margin-top: 27px; }
.hint { margin-top: 25px; color: var(--echo-muted); font-size: 15px; letter-spacing: 2px; -unity-text-align: middle-center; }
.level-grid { width: 680px; height: 170px; flex-direction: row; flex-wrap: wrap; justify-content: center; align-content: center; }
.level-button { width: 310px; height: 58px; margin-top: 6px; margin-bottom: 6px; font-size: 19px; }
.small { width: 150px; height: 43px; font-size: 18px; }
.back-button { position: absolute; right: 4px; bottom: 2px; }
.scanline { position: absolute; left: 0; right: 0; height: 1px; background-color: rgba(103, 255, 255, 0.07); }
.scanline-one { top: 182px; } .scanline-two { top: 388px; }
.status { position: absolute; left: 31px; bottom: 21px; color: rgba(110, 213, 215, 0.65); font-size: 12px; letter-spacing: 1px; }

.tutorial-button { width: 320px; height: 58px; margin-top: 13px; font-size: 21px; }
