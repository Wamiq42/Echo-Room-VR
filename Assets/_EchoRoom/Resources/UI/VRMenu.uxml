<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="project://database/Assets/_EchoRoom/Resources/UI/VRMenu.uss?fileID=7433441132597879392&amp;guid=2becd1cdd6fe8ee4ab3ad33fdeaecfa9&amp;type=3#VRMenu" />
  <ui:VisualElement name="menu-root" class="menu-root">
    <ui:VisualElement class="background-dim" picking-mode="Ignore" />
    <ui:VisualElement class="sonar-ring sonar-ring-outer" picking-mode="Ignore" />
    <ui:VisualElement class="sonar-ring sonar-ring-middle" picking-mode="Ignore" />
    <ui:VisualElement class="sonar-ring sonar-ring-inner" picking-mode="Ignore" />

    <ui:VisualElement class="panel-shell">
      <ui:VisualElement class="panel-glow" picking-mode="Ignore" />
      <ui:VisualElement class="frame" picking-mode="Ignore" />
      <ui:VisualElement class="panel-corner corner-top-left" picking-mode="Ignore" />
      <ui:VisualElement class="panel-corner corner-top-right" picking-mode="Ignore" />
      <ui:VisualElement class="panel-corner corner-bottom-left" picking-mode="Ignore" />
      <ui:VisualElement class="panel-corner corner-bottom-right" picking-mode="Ignore" />

      <ui:VisualElement name="start-screen" class="screen start-screen">
        <ui:Label text="Echo Room VR : Escape the Dark" class="title main-title" />
        <ui:VisualElement class="title-divider" picking-mode="Ignore">
          <ui:VisualElement class="divider-line" />
          <ui:VisualElement class="divider-core" />
          <ui:VisualElement class="divider-line" />
        </ui:VisualElement>
        <ui:Label text="PLAY BLIND. SEE WITH SOUND." class="subtitle main-tagline" />
        <ui:VisualElement class="main-menu-actions">
          <ui:Button name="new-game-button" text="NEW GAME" class="menu-button primary main-menu-button" />
          <ui:Button name="load-game-button" text="LOAD GAME" class="menu-button main-menu-button" />
          <ui:Button name="tutorial-replay-button" text="PLAY TUTORIAL" class="menu-button main-menu-button" />
          <ui:Button name="main-settings-button" text="SETTINGS" class="menu-button main-menu-button" />
          <ui:Button name="privacy-policy-button" text="PRIVACY POLICY" class="menu-button main-menu-button policy-link-button" />
        </ui:VisualElement>
        <ui:Label text="POINT WITH A CONTROLLER  //  PRESS TRIGGER" class="hint main-hint" />
      </ui:VisualElement>

      <ui:VisualElement name="privacy-screen" class="screen hidden privacy-screen">
        <ui:Label text="PRIVACY POLICY" class="title privacy-title" />
        <ui:Label text="ONE-TIME ACCEPTANCE" class="subtitle" />
        <ui:VisualElement class="signal-line privacy-line" />
        <ui:Label text="Before playing Echo Room, please review and accept the Privacy Policy. The policy will open in your browser." class="body privacy-copy" />
        <ui:Label text="w42dev.netlify.app" class="privacy-url" />
        <ui:VisualElement class="privacy-actions">
          <ui:Button name="privacy-review-button" text="REVIEW PRIVACY POLICY" class="menu-button privacy-action-button" />
          <ui:Button name="privacy-accept-button" text="I ACCEPT" class="menu-button primary privacy-action-button" />
        </ui:VisualElement>
        <ui:Label text="ACCEPTANCE IS SAVED ON THIS DEVICE" class="hint privacy-hint" />
      </ui:VisualElement>

      <ui:VisualElement name="level-screen" class="screen hidden">
        <ui:Label text="LOAD GAME" class="title section-title" />
        <ui:Label text="SELECT AN UNLOCKED SIGNAL" class="subtitle" />
        <ui:VisualElement class="signal-line" />
        <ui:Label text="Completing a level unlocks the next facility section." class="body compact" />
        <ui:VisualElement class="level-grid">
          <ui:Button name="level-1-button" text="LEVEL 1" class="menu-button level-button" />
          <ui:Button name="level-2-button" text="LEVEL 2" class="menu-button level-button" />
          <ui:Button name="level-3-button" text="LEVEL 3" class="menu-button level-button" />
          <ui:Button name="level-4-button" text="LEVEL 4" class="menu-button level-button" />
          <ui:Button name="level-5-button" text="LEVEL 5" class="menu-button level-button" />
        </ui:VisualElement>
        <ui:Button name="level-back-button" text="BACK" class="menu-button small back-button" />
      </ui:VisualElement>

      <ui:VisualElement name="warning-screen" class="screen hidden">
        <ui:Label text="OVERWRITE SAVE?" class="title section-title warning-text" />
        <ui:Label text="NEW GAME WILL RESET PROGRESS" class="subtitle warning-text" />
        <ui:VisualElement class="signal-line danger-line" />
        <ui:Label text="All unlocked levels and completed-level progress will be erased." class="body" />
        <ui:VisualElement class="button-row warning-actions">
          <ui:Button name="confirm-new-game-button" text="START NEW GAME" class="menu-button danger" />
          <ui:Button name="cancel-new-game-button" text="CANCEL" class="menu-button secondary" />
        </ui:VisualElement>
        <ui:Label text="THIS CANNOT BE UNDONE" class="hint warning-text" />
      </ui:VisualElement>

      <ui:VisualElement name="pause-screen" class="screen hidden">
        <ui:Label text="SIGNAL PAUSED" class="title section-title" />
        <ui:Label text="ECHO LINK SUSPENDED" class="subtitle" />
        <ui:VisualElement class="signal-line" />
        <ui:Label text="The room is holding its breath." class="body compact" />
        <ui:VisualElement class="pause-actions">
          <ui:Button name="continue-button" text="CONTINUE" class="menu-button primary pause-button" />
          <ui:Button name="pause-settings-button" text="SETTINGS" class="menu-button pause-button" />
          <ui:Button name="pause-return-button" text="RETURN TO MENU" class="menu-button secondary pause-button" />
        </ui:VisualElement>
        <ui:Label text="PRESS THE MENU BUTTON TO RESUME" class="hint" />
      </ui:VisualElement>

      <ui:VisualElement name="settings-screen" class="screen hidden settings-screen">
        <ui:Label text="SETTINGS" class="title settings-title" />
        <ui:Label text="COMFORT &amp; LOCOMOTION" class="subtitle settings-subtitle" />
        <ui:VisualElement class="signal-line settings-line" />
        <ui:VisualElement class="setting-row">
          <ui:Label text="LOCOMOTION" class="setting-label" />
          <ui:Button name="locomotion-mode-button" text="SMOOTH" class="menu-button setting-value-button" />
        </ui:VisualElement>
        <ui:VisualElement class="setting-row">
          <ui:Label text="TURN MODE" class="setting-label" />
          <ui:Button name="turn-mode-button" text="SNAP" class="menu-button setting-value-button" />
        </ui:VisualElement>
        <ui:VisualElement class="setting-row">
          <ui:Label text="TURN SPEED" class="setting-label" />
          <ui:VisualElement class="setting-stepper">
            <ui:Button name="turn-speed-down-button" text="-" class="menu-button step-button" />
            <ui:Label name="turn-speed-value" text="60 DEG/S" class="setting-number" />
            <ui:Button name="turn-speed-up-button" text="+" class="menu-button step-button" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="setting-row">
          <ui:Label text="HANDEDNESS" class="setting-label" />
          <ui:Button name="handedness-button" text="BOTH" class="menu-button setting-value-button" />
        </ui:VisualElement>
        <ui:VisualElement class="setting-row">
          <ui:Label text="COMFORT VIGNETTE" class="setting-label" />
          <ui:Button name="vignette-button" text="ON" class="menu-button setting-value-button" />
        </ui:VisualElement>
        <ui:VisualElement class="setting-row">
          <ui:Label text="HEIGHT OFFSET" class="setting-label" />
          <ui:VisualElement class="setting-stepper">
            <ui:Button name="height-offset-down-button" text="-" class="menu-button step-button" />
            <ui:Label name="height-offset-value" text="0.00 M" class="setting-number" />
            <ui:Button name="height-offset-up-button" text="+" class="menu-button step-button" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button name="settings-back-button" text="BACK" class="menu-button small settings-back-button" />
      </ui:VisualElement>

      <ui:VisualElement name="captured-screen" class="screen hidden">
        <ui:Label text="SIGNAL LOST" class="title section-title danger-text" />
        <ui:Label text="YOU HAVE BEEN CAPTURED" class="subtitle danger-text" />
        <ui:VisualElement class="signal-line danger-line" />
        <ui:Label text="The room has gone silent. Re-enter the signal or return to the beginning." class="body" />
        <ui:VisualElement class="button-row warning-actions">
          <ui:Button name="restart-button" text="RESTART" class="menu-button danger" />
          <ui:Button name="return-button" text="RETURN TO MENU" class="menu-button secondary compact-label" />
        </ui:VisualElement>
      </ui:VisualElement>

      <ui:VisualElement class="scanline scanline-one" picking-mode="Ignore" />
      <ui:VisualElement class="scanline scanline-two" picking-mode="Ignore" />
      <ui:Label text="ECHO NETWORK  //  LOCAL" class="status" picking-mode="Ignore" />
      <ui:Label name="app-version-label" text="" class="app-version" picking-mode="Ignore" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
