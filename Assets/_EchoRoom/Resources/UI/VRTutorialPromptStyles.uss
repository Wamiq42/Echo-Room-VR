.tutorial-prompt-root {
  width: 700px;
  height: 260px;
  flex-grow: 0;
  overflow: hidden;
  color: var(--echo-white);
}

.prompt-shadow {
  position: absolute;
  left: 18px;
  right: 4px;
  top: 14px;
  bottom: 2px;
  background-color: rgba(0, 0, 0, 0.52);
  border-top-left-radius: 18px;
  border-top-right-radius: 18px;
  border-bottom-left-radius: 18px;
  border-bottom-right-radius: 18px;
}

.prompt-shell {
  position: absolute;
  left: 8px;
  right: 12px;
  top: 8px;
  bottom: 12px;
  overflow: hidden;
  background-color: rgba(2, 11, 16, 0.96);
  border-left-width: 2px;
  border-right-width: 2px;
  border-top-width: 2px;
  border-bottom-width: 2px;
  border-left-color: rgba(45, 226, 230, 0.72);
  border-right-color: rgba(45, 226, 230, 0.72);
  border-top-color: rgba(45, 226, 230, 0.72);
  border-bottom-color: rgba(45, 226, 230, 0.72);
  border-top-left-radius: 16px;
  border-top-right-radius: 16px;
  border-bottom-left-radius: 16px;
  border-bottom-right-radius: 16px;
}

.prompt-glow {
  position: absolute;
  left: 36px;
  right: 36px;
  top: 10px;
  height: 2px;
  background-color: rgba(80, 246, 247, 0.62);
}

.prompt-frame {
  position: absolute;
  left: 10px;
  right: 10px;
  top: 10px;
  bottom: 10px;
  border-left-width: 1px;
  border-right-width: 1px;
  border-top-width: 1px;
  border-bottom-width: 1px;
  border-left-color: rgba(45, 226, 230, 0.18);
  border-right-color: rgba(45, 226, 230, 0.18);
  border-top-color: rgba(45, 226, 230, 0.18);
  border-bottom-color: rgba(45, 226, 230, 0.18);
}

.prompt-corner {
  position: absolute;
  width: 24px;
  height: 24px;
}

.corner-top-left {
  left: 7px;
  top: 7px;
  border-left-width: 3px;
  border-top-width: 3px;
  border-left-color: var(--echo-cyan);
  border-top-color: var(--echo-cyan);
}

.corner-top-right {
  right: 7px;
  top: 7px;
  border-right-width: 3px;
  border-top-width: 3px;
  border-right-color: var(--echo-cyan);
  border-top-color: var(--echo-cyan);
}

.corner-bottom-left {
  left: 7px;
  bottom: 7px;
  border-left-width: 3px;
  border-bottom-width: 3px;
  border-left-color: var(--echo-cyan);
  border-bottom-color: var(--echo-cyan);
}

.corner-bottom-right {
  right: 7px;
  bottom: 7px;
  border-right-width: 3px;
  border-bottom-width: 3px;
  border-right-color: var(--echo-cyan);
  border-bottom-color: var(--echo-cyan);
}

.prompt-content {
  position: absolute;
  left: 34px;
  right: 34px;
  top: 18px;
  bottom: 20px;
  align-items: center;
  justify-content: flex-start;
}

.prompt-heading {
  width: 100%;
  height: 44px;
  min-height: 44px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.prompt-pulse {
  width: 8px;
  height: 8px;
  margin-left: 15px;
  margin-right: 15px;
  background-color: var(--echo-cyan);
  border-top-left-radius: 4px;
  border-top-right-radius: 4px;
  border-bottom-left-radius: 4px;
  border-bottom-right-radius: 4px;
}

.prompt-title {
  color: var(--echo-white);
  font-size: 30px;
  -unity-font-style: bold;
  -unity-text-align: middle-center;
  -unity-text-outline-width: 1px;
  -unity-text-outline-color: rgba(0, 6, 10, 0.92);
  letter-spacing: 7px;
}

.prompt-divider {
  width: 560px;
  height: 18px;
  margin-top: 1px;
  margin-bottom: 7px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.divider-line {
  width: 259px;
  height: 1px;
  background-color: rgba(45, 226, 230, 0.48);
}

.divider-core {
  width: 10px;
  height: 10px;
  margin-left: 7px;
  margin-right: 7px;
  border-left-width: 1px;
  border-right-width: 1px;
  border-top-width: 1px;
  border-bottom-width: 1px;
  border-left-color: var(--echo-cyan);
  border-right-color: var(--echo-cyan);
  border-top-color: var(--echo-cyan);
  border-bottom-color: var(--echo-cyan);
  border-top-left-radius: 5px;
  border-top-right-radius: 5px;
  border-bottom-left-radius: 5px;
  border-bottom-right-radius: 5px;
}

.prompt-body {
  width: 600px;
  height: 96px;
  color: rgb(197, 228, 234);
  font-size: 19px;
  -unity-font-style: bold;
  -unity-text-align: middle-center;
  -unity-text-outline-width: 1px;
  -unity-text-outline-color: rgba(0, 6, 10, 0.92);
  white-space: normal;
  letter-spacing: 1px;
}

.prompt-body.compact-copy {
  font-size: 18px;
  letter-spacing: 0px;
}

.prompt-status {
  position: absolute;
  right: 0;
  bottom: 0;
  color: rgba(110, 213, 215, 0.58);
  font-size: 9px;
  letter-spacing: 2px;
  -unity-text-align: middle-right;
}

.warning-state .prompt-shell {
  border-left-color: rgba(255, 92, 122, 0.78);
  border-right-color: rgba(255, 92, 122, 0.78);
  border-top-color: rgba(255, 92, 122, 0.78);
  border-bottom-color: rgba(255, 92, 122, 0.78);
}

.warning-state .prompt-title {
  color: rgb(255, 173, 145);
}

.warning-state .prompt-glow,
.warning-state .divider-line,
.warning-state .prompt-pulse {
  background-color: rgba(255, 92, 122, 0.76);
}

.warning-state .divider-core,
.warning-state .corner-top-left,
.warning-state .corner-top-right,
.warning-state .corner-bottom-left,
.warning-state .corner-bottom-right {
  border-left-color: var(--echo-danger);
  border-right-color: var(--echo-danger);
  border-top-color: var(--echo-danger);
  border-bottom-color: var(--echo-danger);
}

/* Auditor dossier state. Amber rather than the cyan of an instruction or the red of the WARNING
   beat: these are facility records being read out, not an alarm. Coming straight after the red
   warning, returning to cyan would read as "danger over", which is the opposite of the intent. */
.auditor-state .prompt-shell {
  border-left-color: rgba(255, 176, 59, 0.80);
  border-right-color: rgba(255, 176, 59, 0.80);
  border-top-color: rgba(255, 176, 59, 0.80);
  border-bottom-color: rgba(255, 176, 59, 0.80);
}

.auditor-state .prompt-title {
  color: rgb(255, 214, 138);
}

.auditor-state .prompt-glow,
.auditor-state .divider-line,
.auditor-state .prompt-pulse {
  background-color: rgba(255, 176, 59, 0.72);
}

.auditor-state .divider-core,
.auditor-state .corner-top-left,
.auditor-state .corner-top-right,
.auditor-state .corner-bottom-left,
.auditor-state .corner-bottom-right {
  border-left-color: rgb(255, 176, 59);
  border-right-color: rgb(255, 176, 59);
  border-top-color: rgb(255, 176, 59);
  border-bottom-color: rgb(255, 176, 59);
}
