<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="project://database/Assets/_EchoRoom/Resources/UI/VRMenu.uss?fileID=7433441132597879392&amp;guid=2becd1cdd6fe8ee4ab3ad33fdeaecfa9&amp;type=3#VRMenu" />
  <Style src="project://database/Assets/_EchoRoom/Resources/UI/VRTutorialPromptStyles.uss?fileID=7433441132597879392&amp;guid=61a083e7bf3f49d799e61d1f742a496e&amp;type=3#VRTutorialPromptStyles" />
  <ui:VisualElement name="tutorial-prompt-root" class="tutorial-prompt-root hidden" picking-mode="Ignore">
    <ui:VisualElement class="prompt-shadow" picking-mode="Ignore" />
    <ui:VisualElement class="prompt-shell" picking-mode="Ignore">
      <ui:VisualElement class="panel-glow prompt-glow" picking-mode="Ignore" />
      <ui:VisualElement class="frame prompt-frame" picking-mode="Ignore" />
      <ui:VisualElement class="panel-corner prompt-corner corner-top-left" picking-mode="Ignore" />
      <ui:VisualElement class="panel-corner prompt-corner corner-top-right" picking-mode="Ignore" />
      <ui:VisualElement class="panel-corner prompt-corner corner-bottom-left" picking-mode="Ignore" />
      <ui:VisualElement class="panel-corner prompt-corner corner-bottom-right" picking-mode="Ignore" />

      <ui:VisualElement class="prompt-content" picking-mode="Ignore">
        <ui:VisualElement class="prompt-heading" picking-mode="Ignore">
          <ui:VisualElement class="prompt-pulse" picking-mode="Ignore" />
          <ui:Label name="tutorial-prompt-title" text="SONAR" class="title prompt-title" picking-mode="Ignore" />
          <ui:VisualElement class="prompt-pulse" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="tutorial-prompt-divider" class="title-divider prompt-divider" picking-mode="Ignore">
          <ui:VisualElement class="divider-line" picking-mode="Ignore" />
          <ui:VisualElement class="divider-core" picking-mode="Ignore" />
          <ui:VisualElement class="divider-line" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:Label name="tutorial-prompt-body" text="Press B to reveal the corridor." class="body prompt-body" picking-mode="Ignore" />
        <ui:Label text="ECHO GUIDANCE  //  WORLD LOCKED" class="status prompt-status" picking-mode="Ignore" />
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
